{
  "name": "explore-senegal",
  "version": "1.0.0",
  "private": true,
  "description": "Application locale Explore Senegal avec JSON Server pour authentification.",
  "scripts": {
    "api": "json-server --watch db.json --port 3000",
    "serve": "http-server . -c-1 -p 8080",
    "dev": "concurrently \"npm run api\" \"npm run serve\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1",
    "json-server": "^0.17.3"
  }
}
